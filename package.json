{
  "name": "ebook-renamer",
  "version": "1.0.0",
  "private": true,
  "description": "Scan folder EPUB/PDF, cari judul & penulis via Open Library / Google Books, lalu rename file.",
  "author": {
    "name": "Ebook Renamer",
    "email": "dev@ebook-renamer.local"
  },
  "homepage": "https://example.com/ebook-renamer",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node launch.mjs",
    "start:dev": "electron .",
    "build:client": "npm --prefix client run build",
    "dist": "npm run build:client && electron-builder --linux"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.ebookrenamer",
    "productName": "Ebook Renamer",
    "asar": true,
    "files": [
      "electron/**",
      "server/src/**",
      "client/dist/**",
      "node_modules/**"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
